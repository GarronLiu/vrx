<?xml version="1.0"?>
<!--
  Launch the generated dynamic-channel world. The world already contains the
  channel extension, static obstacles, and parameterized moving ships; this
  launch only spawns the WAM-V by default.
-->
<launch>
  <arg name="world" default="$(find vrx_gazebo)/worlds/dynamic_channel.world"/>
  <arg name="gui" default="true"/>
  <arg name="verbose" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="extra_gazebo_args" default=""/>
  <arg name="namespace" default="wamv"/>
  <arg name="thrust_config" default="T"/>
  <arg name="vrx_sensors_enabled" default="true"/>
  <arg name="wamv_locked" default="false"/>
  <arg name="keyboard_enabled" default="true"/>
  <arg name="spawn_wamv" default="true"/>

  <!-- WAM-V test start, just before the new channel entrance. -->
  <arg name="x" default="-582.83"/>
  <arg name="y" default="208.39"/>
  <arg name="z" default="0.1"/>
  <arg name="R" default="0"/>
  <arg name="P" default="0"/>
  <arg name="Y" default="1.002"/>

  <arg name="channel_extension_enabled" default="true"/>
  <!-- Enable only when overriding 'world' with a base world without these models. -->
  <arg name="spawn_dynamic_actors" default="false"/>
  <arg name="spawn_static_obstacles" default="false"/>
  <arg name="cross_ship_1_enabled" default="true"/>
  <arg name="cross_ship_2_enabled" default="true"/>
  <arg name="head_on_ship_enabled" default="true"/>
  <arg name="slow_ship_enabled" default="true"/>

  <include file="$(find vrx_gazebo)/launch/vrx.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="verbose" value="$(arg verbose)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="extra_gazebo_args" value="$(arg extra_gazebo_args)"/>
    <arg name="namespace" value="$(arg namespace)"/>
    <arg name="thrust_config" value="$(arg thrust_config)"/>
    <arg name="vrx_sensors_enabled" value="$(arg vrx_sensors_enabled)"/>
    <arg name="wamv_locked" value="$(arg wamv_locked)"/>
    <arg name="keyboard_enabled" value="$(arg keyboard_enabled)"/>
    <arg name="spawn_wamv" value="$(arg spawn_wamv)"/>
    <arg name="obstacle_ship_enabled" value="false"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
    <arg name="R" value="$(arg R)"/>
    <arg name="P" value="$(arg P)"/>
    <arg name="Y" value="$(arg Y)"/>
  </include>

  <group if="$(arg spawn_dynamic_actors)">
  <!--
    Channel corners (world frame):
      (-545, 203), (-553, 265), (-276, 324), (-273, 285)
    The extension model is centered at (-411.75, 269.25) and rotated by
    0.251397 rad; each boundary contains 49 buoys at about 6 m spacing.
  -->
  <node if="$(arg channel_extension_enabled)"
        name="spawn_dynamic_channel_extension"
        pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-sdf -file $(find vrx_gazebo)/models/dynamic_channel_extension/model.sdf
              -model dynamic_channel_extension -x -411.75 -y 269.25 -Y 0.251397"/>
  </group>

  <!-- Deterministic random blocks made from static robotx light buoys. -->
  <node if="$(arg spawn_static_obstacles)"
        name="spawn_static_buoy_obstacles"
        pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-sdf -file $(find vrx_gazebo)/models/static_buoy_obstacles/model.sdf
              -model static_buoy_obstacles -x -411.75 -y 269.25 -Y 0.251397"/>
</launch>
